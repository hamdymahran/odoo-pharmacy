<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_lot_expiry" model="ir.cron">
            <field name="name">الصيدلية: تحديث حالة صلاحية الدفعات</field>
            <field name="model_id" ref="model_pharmacy_cron"/>
            <field name="state">code</field>
            <field name="code">model.check_lot_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_sfda_registration" model="ir.cron">
            <field name="name">الصيدلية: تنبيه انتهاء تسجيل SFDA</field>
            <field name="model_id" ref="model_pharmacy_cron"/>
            <field name="state">code</field>
            <field name="code">model.check_sfda_registration_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
