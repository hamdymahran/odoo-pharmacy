<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_pharmacy_prescription" model="ir.sequence">
            <field name="name">وصفة طبية</field>
            <field name="code">pharmacy.prescription</field>
            <field name="prefix">RX/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_pharmacy_controlled_log" model="ir.sequence">
            <field name="name">سجل المخدّرات</field>
            <field name="code">pharmacy.controlled.log</field>
            <field name="prefix">CTRL/%(year)s/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_dtts_transaction" model="ir.sequence">
            <field name="name">عملية رصد</field>
            <field name="code">dtts.transaction</field>
            <field name="prefix">DTTS/%(year)s/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
