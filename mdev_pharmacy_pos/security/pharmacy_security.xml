<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_pharmacy" model="ir.module.category">
            <field name="name">الصيدلية</field>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_pharmacy" model="res.groups.privilege">
            <field name="name">الصيدلية</field>
            <field name="sequence">20</field>
            <field name="category_id" ref="module_category_pharmacy"/>
        </record>

        <record id="group_pharmacy_user" model="res.groups">
            <field name="name">صيدلي</field>
            <field name="privilege_id" ref="privilege_pharmacy"/>
            <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        </record>

        <record id="group_pharmacy_manager" model="res.groups">
            <field name="name">مدير صيدلية</field>
            <field name="privilege_id" ref="privilege_pharmacy"/>
            <field name="implied_ids" eval="[(4, ref('group_pharmacy_user')), (4, ref('point_of_sale.group_pos_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- المواد المخدّرة: القراءة للصيدلي، التعديل للمدير فقط -->
        <record id="rule_controlled_log_manager" model="ir.rule">
            <field name="name">سجل المخدّرات - المدير</field>
            <field name="model_id" ref="model_pharmacy_controlled_log"/>
            <field name="groups" eval="[(4, ref('group_pharmacy_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
