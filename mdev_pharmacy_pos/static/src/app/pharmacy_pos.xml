<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="mdev_pharmacy_pos.PrescriptionPopup">
        <div class="popup popup-pharmacy-prescription">
            <div class="modal-header">
                <h4 class="modal-title title"><t t-esc="props.title"/></h4>
            </div>
            <main class="modal-body body">
                الدواء: <b class="pharmacy-product"><t t-esc="props.productName"/></b>
                <div class="pharmacy-rx-form">
                    <table>
                        <tr>
                            <td>اسم المريض *</td>
                            <td><input class="rx-patient-name form-control" type="text" placeholder="إلزامي"
                                       t-model="state.patient_name" t-att-style="state.error ? 'border-color:red' : ''"/></td>
                        </tr>
                        <tr><td>رقم الهوية</td><td><input class="rx-patient-id form-control" type="text" t-model="state.patient_id_number"/></td></tr>
                        <tr><td>جوال المريض</td><td><input class="rx-patient-phone form-control" type="text" t-model="state.patient_phone"/></td></tr>
                        <tr><td>اسم الطبيب</td><td><input class="rx-doctor form-control" type="text" t-model="state.doctor_name"/></td></tr>
                        <tr><td>ترخيص الطبيب</td><td><input class="rx-doctor-license form-control" type="text" t-model="state.doctor_license"/></td></tr>
                        <tr>
                            <td>نوع الوصفة</td>
                            <td>
                                <select class="rx-type form-select" t-model="state.prescription_type">
                                    <t t-foreach="types" t-as="type" t-key="type[0]">
                                        <option t-att-value="type[0]"><t t-esc="type[1]"/></option>
                                    </t>
                                </select>
                            </td>
                        </tr>
                    </table>
                </div>
            </main>
            <footer class="footer modal-footer">
                <div class="button confirm btn btn-lg btn-primary" t-on-click="confirm"><t t-esc="props.confirmText"/></div>
                <div class="button cancel btn btn-lg btn-secondary" t-on-click="cancel"><t t-esc="props.cancelText"/></div>
            </footer>
        </div>
    </t>

    <t t-name="mdev_pharmacy_pos.OrdersPopup">
        <div class="popup popup-pharmacy-orders">
            <div class="modal-header">
                <h4 class="modal-title title"><t t-esc="props.title"/></h4>
            </div>
            <main class="modal-body pharmacy-orders-body">
                <input class="order-search form-control d-inline-block" type="text" placeholder="بحث برقم الفاتورة" t-model="state.search"/>
                <div class="button search-btn btn btn-primary" t-on-click="() => this.load()">بحث</div>
                <div class="pharmacy-orders-scroll">
                    <table class="pharmacy-orders-table">
                        <thead>
                            <tr><th>الفاتورة</th><th>العميل</th><th>الإجمالي</th><th>التاريخ</th></tr>
                        </thead>
                        <tbody class="orders-list">
                            <t t-foreach="state.orders" t-as="o" t-key="o.id">
                                <tr class="order-row" t-on-click="() => this.select(o.id)">
                                    <td><t t-esc="o.name"/></td>
                                    <td><t t-esc="o.partner || '-'"/></td>
                                    <td><t t-esc="money(o.amount_total)"/></td>
                                    <td><t t-esc="o.date_order"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </main>
            <footer class="footer modal-footer">
                <div class="button cancel btn btn-lg btn-secondary" t-on-click="cancel"><t t-esc="props.cancelText"/></div>
            </footer>
        </div>
    </t>

    <t t-name="mdev_pharmacy_pos.PrintPopup">
        <div class="popup popup-pharmacy-print">
            <div class="modal-header">
                <h4 class="modal-title title"><t t-esc="props.title"/></h4>
            </div>
            <main class="modal-body">
                <div class="print-content"><t t-out="html"/></div>
            </main>
            <footer class="footer modal-footer">
                <div class="button print-btn btn btn-lg btn-primary" t-on-click="print">طباعة</div>
                <div class="button cancel btn btn-lg btn-secondary" t-on-click="cancel"><t t-esc="props.cancelText"/></div>
            </footer>
        </div>
    </t>

    <t t-name="mdev_pharmacy_pos.RedeemButton">
        <button class="control-button btn btn-light rounded-0 fw-bolder" t-on-click="onClick"><i class="fa fa-gift me-1"/> استبدال نقاط</button>
    </t>
    <t t-name="mdev_pharmacy_pos.ReturnButton">
        <button class="control-button btn btn-light rounded-0 fw-bolder" t-on-click="onClick"><i class="fa fa-undo me-1"/> مرتجع</button>
    </t>
    <t t-name="mdev_pharmacy_pos.ReprintButton">
        <button class="control-button btn btn-light rounded-0 fw-bolder" t-on-click="onClick"><i class="fa fa-print me-1"/> فواتير سابقة</button>
    </t>
    <t t-name="mdev_pharmacy_pos.ZReportButton">
        <button class="control-button btn btn-light rounded-0 fw-bolder" t-on-click="onClick"><i class="fa fa-file-text-o me-1"/> تقرير Z</button>
    </t>

</templates>
