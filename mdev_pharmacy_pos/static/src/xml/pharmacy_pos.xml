<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="PharmacyPrescriptionPopup" owl="1">
        <div role="dialog" class="modal-dialog">
            <div class="popup popup-pharmacy-prescription">
                <header class="title"><t t-esc="props.title"/></header>
                <main class="body">
                    الدواء: <b class="pharmacy-product"><t t-esc="props.productName"/></b>
                </main>
                <div class="pharmacy-rx-form">
                    <table>
                        <tr>
                            <td>اسم المريض *</td>
                            <td><input class="rx-patient-name" type="text" placeholder="إلزامي"
                                       t-model="state.patient_name" t-att-style="state.error ? 'border-color:red' : ''"/></td>
                        </tr>
                        <tr><td>رقم الهوية</td><td><input class="rx-patient-id" type="text" t-model="state.patient_id_number"/></td></tr>
                        <tr><td>جوال المريض</td><td><input class="rx-patient-phone" type="text" t-model="state.patient_phone"/></td></tr>
                        <tr><td>اسم الطبيب</td><td><input class="rx-doctor" type="text" t-model="state.doctor_name"/></td></tr>
                        <tr><td>ترخيص الطبيب</td><td><input class="rx-doctor-license" type="text" t-model="state.doctor_license"/></td></tr>
                        <tr>
                            <td>نوع الوصفة</td>
                            <td>
                                <select class="rx-type" t-model="state.prescription_type">
                                    <t t-foreach="types" t-as="type" t-key="type[0]">
                                        <option t-att-value="type[0]"><t t-esc="type[1]"/></option>
                                    </t>
                                </select>
                            </td>
                        </tr>
                    </table>
                </div>
                <footer class="footer">
                    <div class="button confirm" t-on-click="confirm"><t t-esc="props.confirmText"/></div>
                    <div class="button cancel" t-on-click="cancel"><t t-esc="props.cancelText"/></div>
                </footer>
            </div>
        </div>
    </t>

    <t t-name="PharmacyOrdersPopup" owl="1">
        <div role="dialog" class="modal-dialog">
            <div class="popup popup-pharmacy-orders">
                <header class="title"><t t-esc="props.title"/></header>
                <div class="pharmacy-orders-body">
                    <input class="order-search" type="text" placeholder="بحث برقم الفاتورة" t-model="state.search"/>
                    <div class="button search-btn" t-on-click="load">بحث</div>
                    <div class="pharmacy-orders-scroll">
                        <table class="pharmacy-orders-table">
                            <thead>
                                <tr><th>الفاتورة</th><th>العميل</th><th>الإجمالي</th><th>التاريخ</th></tr>
                            </thead>
                            <tbody class="orders-list">
                                <t t-foreach="state.orders" t-as="o" t-key="o.id">
                                    <tr class="order-row" t-on-click="select(o.id)">
                                        <td><t t-esc="o.name"/></td>
                                        <td><t t-esc="o.partner || '-'"/></td>
                                        <td><t t-esc="money(o.amount_total)"/></td>
                                        <td><t t-esc="o.date_order"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
                <footer class="footer">
                    <div class="button cancel" t-on-click="cancel"><t t-esc="props.cancelText"/></div>
                </footer>
            </div>
        </div>
    </t>

    <t t-name="PharmacyPrintPopup" owl="1">
        <div role="dialog" class="modal-dialog">
            <div class="popup popup-pharmacy-print">
                <header class="title"><t t-esc="props.title"/></header>
                <div class="print-content"><t t-raw="props.html"/></div>
                <footer class="footer">
                    <div class="button print-btn" t-on-click="print">طباعة</div>
                    <div class="button cancel" t-on-click="cancel"><t t-esc="props.cancelText"/></div>
                </footer>
            </div>
        </div>
    </t>

    <t t-name="PharmacyRedeemButton" owl="1">
        <div class="control-button"><i class="fa fa-gift"/> استبدال نقاط</div>
    </t>
    <t t-name="PharmacyReturnButton" owl="1">
        <div class="control-button"><i class="fa fa-undo"/> مرتجع</div>
    </t>
    <t t-name="PharmacyReprintButton" owl="1">
        <div class="control-button"><i class="fa fa-print"/> فواتير سابقة</div>
    </t>
    <t t-name="PharmacyZReportButton" owl="1">
        <div class="control-button"><i class="fa fa-file-text-o"/> تقرير Z</div>
    </t>

</templates>
