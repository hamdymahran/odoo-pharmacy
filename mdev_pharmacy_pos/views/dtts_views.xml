<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dtts_config_form" model="ir.ui.view">
        <field name="name">dtts.config.form</field>
        <field name="model">dtts.config</field>
        <field name="arch" type="xml">
            <form string="إعدادات رصد / DTTS">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="environment"/>
                            <field name="stakeholder_type"/>
                            <field name="gln_id"/>
                            <field name="active"/>
                        </group>
                        <group string="الاتصال">
                            <field name="wsdl_url"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        تحتاج التسجيل لدى SFDA للحصول على GLN وبيانات الاتصال.
                        اختبر على بيئة الاختبار قبل الإنتاج.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dtts_config_tree" model="ir.ui.view">
        <field name="name">dtts.config.tree</field>
        <field name="model">dtts.config</field>
        <field name="arch" type="xml">
            <list string="إعدادات رصد">
                <field name="name"/>
                <field name="environment"/>
                <field name="stakeholder_type"/>
                <field name="gln_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="dtts_transaction_tree" model="ir.ui.view">
        <field name="name">dtts.transaction.tree</field>
        <field name="model">dtts.transaction</field>
        <field name="arch" type="xml">
            <list string="عمليات رصد" create="false"
                  decoration-success="state == 'success'"
                  decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="create_date"/>
                <field name="operation_type"/>
                <field name="gtin"/>
                <field name="serial_number"/>
                <field name="state"/>
                <field name="response_message"/>
            </list>
        </field>
    </record>

    <record id="action_dtts_config" model="ir.actions.act_window">
        <field name="name">إعدادات رصد / DTTS</field>
        <field name="res_model">dtts.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dtts_transaction" model="ir.actions.act_window">
        <field name="name">عمليات رصد</field>
        <field name="res_model">dtts.transaction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
